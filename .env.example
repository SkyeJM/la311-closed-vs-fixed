# Copy to .env (gitignored) and fill in. Never commit real values.

# Socrata app token. Optional: bulk exports work without it; it raises SODA API rate limits.
# Create one free from a data.lacity.org account (profile -> Developer Settings).
SOCRATA_APP_TOKEN=

# Anthropic API key: `make label` (Phase 3) and the Ask agent (Phase 4). Use a dedicated Console
# workspace with its own spend limit. Code checks that it is set and never prints it.
ANTHROPIC_API_KEY=

# Default model for the Ask agent. Evals also compare claude-haiku-5-5 and claude-opus-5-5.
CLAUDE_MODEL=claude-sonnet-5-5

# Daily API spend cap for the public /api/ask, in USD: checked before every model call. The
# Anthropic Console workspace limit is the hard backstop.
DAILY_SPEND_CAP_USD=1.00

# Ask agent effort (low, medium, high). Not CLAUDE_EFFORT: Claude Code sets that one itself.
ASK_EFFORT=medium
# Kill switch for live questions (cached suggested answers keep working).
ASK_ENABLED=true
# Live questions per IP per hour.
ASK_RATE_LIMIT_PER_HOUR=10
# Secret for hashing IPs in rate-limit keys and traces. Required when deployed; any long random
# string (python -c "import secrets; print(secrets.token_hex(32))").
IP_HASH_SALT=
# Read the client IP from x-forwarded-for (true behind a proxy that sets it, such as Vercel).
TRUST_PROXY_HEADERS=false
# Where /api/ask traces go: a directory (default logs/traces) or "stdout".
TRACE_DIR=
